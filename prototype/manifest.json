{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "VALORANT Skin Tracker Capture",
    "author": "Local Prototype",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.310.0.16",
    "description": "Local game-frame bridge for the VALORANT skin tracker.",
    "icon": "overwolf_bridge/icon.png"
  },
  "permissions": ["GameInfo", "Media", "FileSystem"],
  "data": {
    "start_window": "background",
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [21640]
    },
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [21640]
        },
        "start_minimized": true
      }
    ],
    "windows": {
      "background": {
        "file": "overwolf_bridge/background.html",
        "is_background_page": true
      }
    }
  }
}
